# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# DATABASE_URL is used by the Prisma CLI (db push / migrate / studio) for the
# LOCAL SQLite file. The app runtime uses the libSQL driver (see below).
DATABASE_URL="file:./dev.db"

# --- Production: Turso (libSQL) ---------------------------------------------
# When these are set, the app connects to a hosted Turso database instead of
# the local file. Leave them empty for local development.
#   turso db create lead-dashboard
#   turso db show lead-dashboard --url      -> TURSO_DATABASE_URL (libsql://...)
#   turso db tokens create lead-dashboard   -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ----------------------------------------------------------------------------
# Lead Manager (ליד מנג'ר) credentials & scraper configuration
# ----------------------------------------------------------------------------
LEAD_MANAGER_BASE_URL="https://app.lead-manager.co.il"
LEAD_MANAGER_LOGIN_URL="https://app.lead-manager.co.il/login"
LEAD_MANAGER_LEADS_URL="https://app.lead-manager.co.il/leads"
LEAD_MANAGER_USERNAME="your-username@example.com"
LEAD_MANAGER_PASSWORD="your-password"

# Run the browser headless (true) or visible (false — useful for debugging selectors)
HEADLESS=true

# Where the authenticated browser session/cookies are cached so we don't
# have to log in on every sync.
SESSION_STORAGE_PATH="./storage/leadmanager-session.json"

# --- CSS selectors for the Lead Manager pages -------------------------------
# These are configurable so you can adjust them to match the live DOM without
# touching code. Inspect the page (npm run scrape:headed) and update as needed.
SELECTOR_USERNAME="input[name='username'], input[type='email']"
SELECTOR_PASSWORD="input[name='password'], input[type='password']"
SELECTOR_LOGIN_BUTTON="button[type='submit']"
SELECTOR_LOGIN_SUCCESS="nav, [data-page='dashboard'], .dashboard"
SELECTOR_LEADS_TABLE="table tbody tr"

# Column indexes (0-based) within each lead table row.
COL_LEAD_ID="0"
COL_CAMPAIGN="1"
COL_DATETIME="2"
COL_STATUS="3"
COL_SOURCE="4"

# ----------------------------------------------------------------------------
# Monitoring / Alerting
# ----------------------------------------------------------------------------
# Trigger an alert when week-over-week lead volume drops by at least this %.
ALERT_DROP_THRESHOLD_PERCENT="20"

# ----------------------------------------------------------------------------
# Email alerts (Nodemailer SMTP)
# Leave EMAIL_ENABLED=false to skip sending (alerts still surface in the UI).
# ----------------------------------------------------------------------------
EMAIL_ENABLED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user@example.com"
SMTP_PASSWORD="your-smtp-app-password"
ALERT_EMAIL_FROM="Lead Dashboard <alerts@example.com>"
ALERT_EMAIL_TO="admin@example.com"

# ----------------------------------------------------------------------------
# Google organic (SEO) report — Search Console integration
#
# Pulls clicks/impressions/CTR/position + top queries & pages and renders a
# Hebrew PDF report (npm run report:seo). If these are unset, the report still
# generates with realistic MOCK data so you can preview the layout.
#
# Setup:
#   1. Google Cloud → enable "Google Search Console API", create a service
#      account, and download its JSON key.
#   2. Search Console → Settings → Users and permissions → add the service
#      account email (…@….iam.gserviceaccount.com) as a user on the property.
#   3. Set SC_SITE_URL to the EXACT property string:
#        - Domain property:      sc-domain:example.co.il
#        - URL-prefix property:   https://example.co.il/
# ----------------------------------------------------------------------------
SC_SITE_URL=""

# Provide the service-account key EITHER inline (single-line JSON) ...
GOOGLE_SC_CREDENTIALS_JSON=""
# ... OR as a path to the downloaded key file (takes the inline value if both set):
GOOGLE_SC_CREDENTIALS_PATH=""

# Client name shown on the report (override per-run with --client).
SEO_CLIENT_NAME="הלקוח שלי"
# Default recipient when emailing the report (override with --to / to_email).
SEO_REPORT_EMAIL_TO="client@example.com"
