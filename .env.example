# ============================================================================
# CRM — environment configuration
# Copy to .env for local dev. In production these are set in Vercel.
# Full connection walkthroughs: see CONNECTIONS.md
# ============================================================================

# --- Database ---------------------------------------------------------------
# Local dev: SQLite file (npm run db:dev creates it).
# Production (Vercel): Postgres — pooled URL here, direct URL below.
#   Vercel Postgres/Neon integration exposes these automatically; map:
#   DATABASE_URL  = POSTGRES_PRISMA_URL      (pooled, for the app)
#   DIRECT_URL    = POSTGRES_URL_NON_POOLING (direct, for migrations)
DATABASE_URL="file:./dev.db"
DIRECT_URL=""

# --- Auth ---------------------------------------------------------------------
# Long random string — signs session cookies. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Google login (optional until connected; the button hides when empty).
# Google Cloud Console -> OAuth client. Authorized redirect URIs:
#   https://<your-domain>/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback   (for local testing)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- File storage (Cloudflare R2) --------------------------------------------
# Empty in dev -> files are stored on local disk under .uploads/
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Local storage folder override (dev only)
STORAGE_DIR=".uploads"

# --- Email (reminders, automations) -------------------------------------------
# Empty in dev -> emails are logged to console + Message table instead of sent.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="CRM <no-reply@your-domain.co.il>"

# --- SMS / WhatsApp (Phase 3 — leave empty until a provider is chosen) --------
# Supported out of the box: generic HTTP provider adapter (019 style).
SMS_PROVIDER=""            # e.g. "generic019"
SMS_API_URL=""
SMS_API_TOKEN=""
SMS_FROM=""
WHATSAPP_API_URL=""        # WhatsApp Business Cloud API endpoint
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""

# --- Cron protection -----------------------------------------------------------
# Vercel Cron sends this secret; blocks strangers from firing cron endpoints.
CRON_SECRET=""

# --- Receipts uploader (office computer helper script) --------------------------
# Used by scripts/receipts-uploader.mjs, not by the web app itself.
CRM_BASE_URL="http://localhost:3000"
RECEIPTS_UPLOAD_TOKEN=""
RECEIPTS_DIR="C:/Receipts"
