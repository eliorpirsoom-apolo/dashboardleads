{
  "name": "dashboardleads",
  "version": "2.0.0",
  "private": true,
  "description": "Two-sided agency CRM: agency side (clients, tasks, documents) + client side (leads, campaigns, projects, reports). Next.js + Prisma. PostgreSQL in production (Vercel), SQLite mirror for local dev.",
  "scripts": {
    "dev": "npm run db:dev && next dev",
    "build": "next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:dev": "node scripts/gen-sqlite-schema.mjs && prisma db push --schema prisma/schema.sqlite.prisma --skip-generate && prisma generate --schema prisma/schema.sqlite.prisma",
    "db:studio": "prisma studio --schema prisma/schema.sqlite.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:migration:init": "node scripts/gen-postgres-migration.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "receipts:upload": "node scripts/receipts-uploader.mjs",
    "import:legacy": "node --experimental-sqlite scripts/import-legacy.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/s3-request-presigner": "^3.620.0",
    "@prisma/client": "^5.18.0",
    "@tremor/react": "^3.18.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "next": "14.2.5",
    "nodemailer": "^6.9.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "playwright": "^1.46.0",
    "postcss": "^8.4.39",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
