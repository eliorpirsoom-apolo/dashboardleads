{
  "name": "dashboardleads",
  "version": "1.0.0",
  "private": true,
  "description": "Campaign & Lead Management Dashboard for Lead Manager (ליד מנג'ר) with Playwright scraping, SQLite caching, and a Next.js dashboard.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "scrape": "tsx scripts/sync.ts",
    "scrape:headed": "HEADLESS=false tsx scripts/sync.ts",
    "report:seo": "tsx scripts/seo-report.ts",
    "report:seo:check": "tsx scripts/seo-check.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.8.1",
    "@prisma/adapter-libsql": "^5.22.0",
    "@prisma/client": "^5.18.0",
    "@tremor/react": "^3.18.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "google-auth-library": "^10.9.0",
    "next": "14.2.5",
    "nodemailer": "^6.9.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "playwright": "^1.46.0",
    "postcss": "^8.4.39",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
