// Prisma schema for the Campaign & Lead Management Dashboard.
// Uses SQLite as a local cache for data scraped from Lead Manager (ליד מנג'ר).

generator client {
  provider        = "prisma-client-js"
  // Driver adapters let us talk to Turso (libSQL) in production while keeping
  // the same `sqlite` provider for local development.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A marketing campaign. Leads belong to a campaign.
model Campaign {
  id          String   @id @default(cuid())
  // The campaign name exactly as it appears in Lead Manager. Used as the
  // natural key when matching scraped rows to existing campaigns.
  name        String   @unique
  // Optional external identifier if Lead Manager exposes one.
  externalId  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads       Lead[]

  @@index([name])
}

// A single lead scraped from Lead Manager.
model Lead {
  id           String    @id @default(cuid())
  // The Lead ID from Lead Manager. Unique per source system — used to
  // de-duplicate during incremental syncs (upsert key).
  externalId   String    @unique
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId   String
  // When the lead was created in Lead Manager (the "Date/Time" column).
  // Stored as an ISO-8601 UTC string (e.g. 2026-06-14T20:30:00.000Z) so that
  // lexical ordering == chronological ordering and range filters work
  // identically across local SQLite and Turso/libSQL (the libSQL driver
  // adapter mis-binds typed DateTime range filters).
  receivedAt   String
  status       String    @default("New")
  source       String    @default("Unknown")
  // Bookkeeping for incremental sync.
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([receivedAt])
  @@index([campaignId])
  @@index([status])
  @@index([source])
  @@index([campaignId, receivedAt])
}

// ---------------------------------------------------------------------------
// Organic SEO reporting (Search Console + Analytics) for agency clients.
// ---------------------------------------------------------------------------

// An agency client we produce an organic SEO report for. Holds the linkage to
// the client's Google Search Console property and GA4 property so the report
// can pull live data; when these are empty the report falls back to demo data.
model Client {
  id            String     @id @default(cuid())
  name          String     @unique
  // Google Search Console property, e.g. "sc-domain:example.com" or
  // "https://example.com/". Empty -> demo data.
  gscProperty   String?
  // Google Analytics 4 numeric property id, e.g. "123456789". Empty -> demo data.
  ga4PropertyId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tasks         SeoTask[]

  @@index([name])
}

// A manually-entered SEO task shown in the client report: either work completed
// this month or work planned for next month.
model SeoTask {
  id         String   @id @default(cuid())
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  title      String
  // "done" (already executed) | "planned" (scheduled).
  status     String   @default("planned")
  // The month the task belongs to, as "yyyy-MM" (e.g. "2026-06").
  dueMonth   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clientId])
  @@index([clientId, status, dueMonth])
}

// Audit log for each scraper/sync run.
model SyncLog {
  id           String    @id @default(cuid())
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  // "success" | "error" | "running"
  status       String    @default("running")
  // Counts captured during the run.
  leadsFound   Int       @default(0)
  leadsCreated Int       @default(0)
  leadsUpdated Int       @default(0)
  // Was a regression detected during this sync?
  alertTriggered Boolean @default(false)
  message      String?   // human-readable summary / error message

  @@index([startedAt])
}
