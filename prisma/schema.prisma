// ============================================================================
// CRM schema — source of truth (PostgreSQL).
//
// Local dev has no Postgres, so scripts/gen-sqlite-schema.mjs generates
// prisma/schema.sqlite.prisma (identical models, provider swapped) for
// dev.db. To keep the two 100% compatible, this schema deliberately avoids
// Postgres-only features: no enums (String instead), no Json (String JSON
// blobs), no @db.* attributes. Do not add them.
//
// "Enum" string fields document their allowed values in a comment.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations. The Vercel Neon
  // integration injects both DATABASE_URL and DATABASE_URL_UNPOOLED.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// Auth / accounts
// ---------------------------------------------------------------------------

// A login account. ADMIN sees everything; CLIENT is scoped to one Client.
// A client's sales agents are simply extra CLIENT users (isAgent = true).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String?
  role         String    @default("CLIENT") // "ADMIN" | "CLIENT"
  // For ADMIN users: "manager" (everything) | "staff" (daily work only).
  adminRole    String    @default("manager")
  // For "staff" admins: JSON array of allowed module keys (null = default set).
  // Managers ignore this and always see every module.
  moduleAccess String?
  isAgent      Boolean   @default(false)
  // מעצב/ת בסטודיו — רק משתמשים מסומנים מופיעים כמעצבים בלוח הסטודיו.
  isDesigner   Boolean   @default(false)
  googleId     String?   @unique
  phone        String?
  // וואטסאפ להתראות לידים (משווקים): נפרד מהטלפון — מספר המענה לרוב וירטואלי
  // ולא מקבל וואטסאפ. נוכחות המספר = הפעלת ההתראה.
  whatsappPhone String?
  birthday     DateTime? // יום הולדת — לבאנר "מזל טוב" בצד המשרד
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  // Bumping invalidates all existing sessions ("log out everywhere").
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedTasks Task[]     @relation("TaskAssignee")
  createdTasks  Task[]     @relation("TaskCreator")
  leadNotes     LeadNote[]
  documents     Document[]
  assignedLeads Lead[]     @relation("LeadAssignee")
  clientAssignments ClientAssignment[]
  projectAssignments ProjectAssignment[]
  calendarConnection CalendarConnection?
  designTasks        DesignTask[] @relation("DesignTaskDesigner")
  designTasksQc      DesignTask[] @relation("DesignTaskQc")
  designTasksCreated DesignTask[] @relation("DesignTaskCreator")
  designAssets       DesignAsset[]
  engagementTasks EngagementTask[] @relation("EngagementTaskAssignee")

  @@index([clientId])
  @@index([role])
}

// חיבור יומן Google אישי (עובד משרד): הלוח המשותף קורא את כל היומנים,
// ופגישות שנוצרות במערכת נכתבות ליומן של המשתמש (דו-כיווני).
model CalendarConnection {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String    @unique
  googleEmail  String
  refreshToken String
  accessToken  String?
  expiresAt    DateTime?
  color        String    @default("#f59e0b") // צבע האירועים של העובד בלוח
  active       Boolean   @default(true)
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// שיוך אנשי מכירות לפרויקטים. סוכן משויך רואה רק את הפרויקטים שלו;
// ה"ראשי" מקבל את הלידים הנכנסים ממקורות הפרויקט (או סבב בין כולם).
model ProjectAssignment {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  isPrimary Boolean @default(false)

  @@unique([projectId, userId])
  @@index([userId])
}

// Prepared for the future "account manager" model (agency staff scoped to
// specific clients). Schema-ready now; enforcement comes later.
model ClientAssignment {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  @@unique([userId, clientId])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Clients (the agency's customers)
// ---------------------------------------------------------------------------

// type decides which modules are enabled:
//   "general"    — core CRM only
//   "realestate" — core + projects/inventory/contracts
//   "seo"        — core + SEO data module
model Client {
  id           String   @id @default(cuid())
  name         String   @unique
  type         String   @default("general") // "general" | "realestate" | "seo"
  company      String?
  companyId    String? // ח.פ / ע.מ — מספר הרישום של החברה
  contactName  String?
  contactEmail String?
  contactPhone String?
  notes        String?
  color        String?
  logoKey      String? // company logo file key in storage
  birthday     String? // תאריך לידה של הלקוח (YYYY-MM-DD) — לברכת יום הולדת אוטומטית
  lastBirthdayGreetYear Int? // השנה האחרונה שבה נשלחה ברכה (למניעת כפילות)
  // הרשאות דיוור (JSON): { allowed:{broadcast,leadAlerts,email,sms,whatsapp}, enabled:{...} }.
  // המשרד מגדיר allowed; הלקוח מגדיר enabled. אפקטיבי = allowed ∧ enabled.
  messagingConfig String?
  // מזהה הלקוח ב-SUMIT (מתמלא אוטומטית בסנכרון לפי התאמת מייל).
  sumitCustomerId Int?
  // Round-robin new leads between the client's sales agents on intake.
  autoAssignLeads Boolean @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users            User[]
  campaigns        Campaign[]
  leads            Lead[]
  statuses         LeadStatus[]
  customFields     CustomFieldDef[]
  sources          LeadSource[]
  tasks            Task[]
  documents        Document[]
  budgets          Budget[]
  projects         Project[]
  purchaseRequests PurchaseRequest[]
  contracts        Contract[]
  topAds           TopAd[]
  messages         Message[]
  broadcasts       Broadcast[]
  automations      Automation[]
  integrations     Integration[]
  seoSnapshots     SeoSnapshot[]
  seoKeywords      SeoKeyword[]
  intakeLogs       IntakeLog[]
  adInsights       AdInsight[]
  quotes           Quote[]
  engagements      Engagement[]
  ganttPlan        GanttPlan?
  messageTemplates MessageTemplate[]
  clientAssignments ClientAssignment[]
  designTasks       DesignTask[]
  whatsappMessages  WhatsappMessage[]
  payments          ClientPayment[]

  @@index([name])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Campaigns
// ---------------------------------------------------------------------------

model Campaign {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  name      String
  kind      String? // סוג קמפיין: "search" | "social" | "video" | "leads" | free text
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?
  status    String   @default("active") // "active" | "paused" | "archived"
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads   Lead[]
  budgets Budget[]

  @@unique([clientId, name])
  @@index([clientId])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Lead statuses — defined per client (name + color + order), system-typed
// ---------------------------------------------------------------------------

// systemKind maps custom statuses to system behavior:
//   "new" | "in_progress" | "won" | "lost"
// A lead entering a "won" status with a unitType linked triggers the
// real-estate inventory automation.
model LeadStatus {
  id         String   @id @default(cuid())
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  name       String
  color      String   @default("#64748b")
  order      Int      @default(0)
  systemKind String   @default("new") // "new" | "in_progress" | "won" | "lost"
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  leads       Lead[]
  automations Automation[]

  @@unique([clientId, name])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Custom fields — defined per client, values stored in Lead.data (JSON)
// ---------------------------------------------------------------------------

model CustomFieldDef {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  key       String
  label     String
  fieldType String   @default("text") // "text" | "number" | "date" | "select" | "boolean"
  options   String? // JSON array of choices for "select"
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([clientId, key])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

model Lead {
  id         String  @id @default(cuid())
  // Human-friendly lead number, sequential PER CLIENT. Assigned in code
  // (transaction + retry) — autoincrement is not portable to SQLite here.
  number     Int     @default(0)
  client     Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  externalId String? // id in the source system (form id, call id...)

  kind String @default("form") // "form" | "call" | "whatsapp" | "manual"

  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId String?
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId  String?
  unitType   UnitType?   @relation(fields: [unitTypeId], references: [id], onDelete: SetNull)
  unitTypeId String?
  status     LeadStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)
  statusId   String?
  source     LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceId   String?
  // מי מטפל בליד — סוכן/משתמש של הלקוח.
  assignee   User?       @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?

  fullName      String?
  phone         String?
  email         String?
  city          String?
  channel       String? // ערוץ הגעה: "facebook" | "google" | "organic" | "phone" | ...
  platform      String? // פלטפורמה: "facebook" | "instagram" | "tiktok" | "web" | ...
  campaignLabel String? // free-text campaign name as sent by the source
  audience      String? // קהל
  adName        String? // מודעה
  consent       Boolean @default(false) // הסכמה לדיוור

  // Call leads (Paycall / CheckCall)
  callDurationSec  Int?
  callRecordingUrl String?
  callStatus       String?
  callAdNumber     String? // מספר פרסומי (ה-DID/CheckCall שאליו התקשרו)
  callTargetNumber String? // מספר הטלפון ביעד (למי נותבה השיחה)
  callTargetName   String? // שם היעד/נציג
  callTranscript   String? // תמלול מלא (מפייקול או מתמלול עצמי מההקלטה)
  callSummary      String? // סיכום שיחה בראשי פרקים
  callRecordingKey String? // מפתח R2 של קובץ ההקלטה ששמרנו אצלנו (עותק קבוע)
  callTranscriptStatus String? // null=טרם, "pending", "done", "failed", "no_audio"

  receivedAt DateTime @default(now())
  archived   Boolean  @default(false)

  // Speed-to-Lead: מתי הליד טופל לראשונה (סטטוס/הערה) + חותמות תזכורות SLA.
  firstHandledAt        DateTime?
  slaMarketerRemindedAt DateTime?
  slaEscalatedAt        DateTime?

  // Custom field values, keyed by CustomFieldDef.key (JSON object as string)
  data String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes            LeadNote[]
  activities       LeadActivity[]
  purchaseRequests PurchaseRequest[]
  contracts        Contract[]
  inventoryEvents  InventoryEvent[]
  tasks            Task[]
  messages         Message[]
  waMessages       WhatsappMessage[]

  @@unique([clientId, number])
  @@index([clientId, receivedAt])
  @@index([clientId, statusId])
  @@index([clientId, assigneeId])
  @@index([campaignId])
  @@index([phone])
  @@index([email])
  @@index([clientId, kind])
}

// ציר פעילות אוטומטי על ליד: מי שינה מה ומתי (בנוסף להערות הידניות).
model LeadActivity {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  actorName String // denormalized — survives user deletion
  // "create" | "status" | "assign" | "archive" | "restore" | "consent" | "merge" | "import"
  kind      String
  fromValue String?
  toValue   String?
  note      String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// Timeline of notes on a lead — who wrote what, when.
model LeadNote {
  id         String   @id @default(cuid())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  authorName String // denormalized so notes survive user deletion
  body       String
  createdAt  DateTime @default(now())

  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Direct intake — one endpoint, token per source (FB via Make/Zapier,
// Elementor webhook, Paycall via Make/Zapier)
// ---------------------------------------------------------------------------

model LeadSource {
  id         String    @id @default(cuid())
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  // מקור של פרויקט: לידים ממנו נכנסים ישר לפרויקט ולסוכניו.
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId  String?
  name       String // "טופס אלמנטור — דף הבית", "פייסבוק לידים — קמפיין X"
  token      String    @unique
  channel    String? // default channel for leads from this source
  platform   String?
  kind       String    @default("form") // default Lead.kind: "form" | "call" | "whatsapp"
  active     Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  leads      Lead[]
  intakeLogs IntakeLog[]

  @@index([clientId])
}

// Audit of every intake hit — what came in, what happened to it.
model IntakeLog {
  id        String      @id @default(cuid())
  source    LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceId  String?
  client    Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String?
  status    String // "ok" | "duplicate" | "error" | "rejected"
  leadId    String?
  error     String?
  payload   String? // raw JSON payload (truncated)
  createdAt DateTime    @default(now())

  @@index([clientId, createdAt])
}

// ---------------------------------------------------------------------------
// Tasks, meetings, reminders
// ---------------------------------------------------------------------------

model Task {
  id          String    @id @default(cuid())
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String? // null = internal agency task not tied to a client
  title       String
  description String?
  type        String    @default("task") // "task" | "meeting"
  ownerSide   String    @default("agency") // "agency" | "client" — המשימות שלנו / של הלקוח
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId  String?
  createdBy   User?     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId      String?
  dueAt       DateTime
  durationMin Int? // meetings: duration
  location    String? // meetings: place / video link
  status      String    @default("open") // "open" | "done" | "canceled"
  completedAt DateTime?
  // סנכרון ליומן Google: האירוע שנוצר + המשתמש שביומנו הוא יושב.
  googleEventId String?
  googleEventOwnerId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reminders Reminder[]

  @@index([clientId, dueAt])
  @@index([assigneeId, dueAt])
  @@index([ownerSide])
  @@index([status, dueAt])
}

// מאגר לכידה מהיר ("Inbox") — זריקת משימות/תזכורות ללא שדות חובה, לסידור מאוחר.
// משותף לכל המשרד. מוכן לחיבור עתידי לסוכן AI שיזין פריטים מהוואטסאפ (source).
model TaskInbox {
  id              String   @id @default(cuid())
  text            String
  status          String   @default("inbox") // "inbox" | "done" | "converted"
  source          String   @default("manual") // "manual" | "whatsapp" | "ai"
  sourceRef       String? // מזהה/פרטי מקור (למשל שולח וואטסאפ) — לעתיד
  createdById     String? // מי לכד (סקלרי — ללא FK, לקלילות)
  createdByName   String?
  convertedTaskId String? // המשימה שנוצרה מהפריט (אם הומר)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
}

// סוכן AI ללכידת משימות מהוואטסאפ אל המאגר. סינגלטון (key="task-capture").
model AiAgentConfig {
  id             String   @id @default(cuid())
  key            String   @unique @default("task-capture")
  name           String   @default("יעקב") // שם הסוכן = מילת הטריגר בקבוצות
  enabled        Boolean  @default(false) // לכידה מצ'אט פרטי (מספרים מורשים)
  groupsEnabled  Boolean  @default(false) // לכידה מקבוצות (בקריאה בשם)
  allowedNumbers String   @default("") // מספרים מורשים (מופרדים בפסיק/שורה)
  instructions   String? // הנחיה מותאמת ל-AI
  model          String? // מודל עוקף (אופציונלי)
  replyConfirm   Boolean  @default(true)
  // בוט תזמון לקבוצות: הודעת בוקר + סוף-יום לכל הקבוצות שהמספר חבר בהן.
  broadcastEnabled  Boolean @default(false)
  morningTime       String  @default("09:00") // HH:MM שעון ישראל
  morningText       String  @default("בוקר טוב לכולם ☀️")
  eodTime           String  @default("17:00")
  eodText           String  @default("היי כולם, אנחנו תכף מסיימים את היום — יש בקשות / הערות?")
  broadcastDays     String  @default("0,1,2,3,4") // ימי שבוע (0=ראשון .. 6=שבת)
  broadcastExcludeGroups String? // JSON: chatIds של קבוצות שהוחרגו מהבוט (ריק = כל הקבוצות)

  // שיחות וואטסאפ עם לידים (צ'אט מכרטיס הליד) — מתג ראשי ברמת המשרד.
  leadChatEnabled Boolean @default(false)

  // Speed-to-Lead (SLA לידים): תזכורת למשווק + הסלמה למנהלים על ליד שלא טופל.
  slaEnabled         Boolean @default(false)
  slaMarketerMinutes Int     @default(15) // דקות עד תזכורת למשווק
  slaEscalateMinutes Int     @default(60) // דקות עד הסלמה למנהלי המשרד
  slaWorkStart       String  @default("08:00") // שליחת תזכורות רק בשעות הפעילות (שעון ישראל)
  slaWorkEnd         String  @default("20:00")
  lastMorningSentOn String? // YYYY-MM-DD (ישראל) — מניעת כפילות
  lastEodSentOn     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// --- לוח תשלומי לקוחות (תזרים) ------------------------------------------------
// סטטוס תשלום צבעוני וניתן להוספה. isPaid = נספר כ"נגבה" בסטטיסטיקות.
model PaymentStatus {
  id        String          @id @default(cuid())
  name      String
  color     String          @default("#94a3b8")
  order     Int             @default(0)
  isPaid    Boolean         @default(false)
  createdAt DateTime        @default(now())
  payments  ClientPayment[]
}

// תא בטבלה: לקוח × חודש (שנה) × סוג → סכום + סטטוס.
// kind מפריד בין תשלום חודשי קבוע ("retainer") לחד-פעמי ("oneoff") — שורה נפרדת לכל סוג.
model ClientPayment {
  id        String         @id @default(cuid())
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  year      Int
  month     Int // 1-12
  kind      String         @default("retainer") // "retainer" | "oneoff"
  amount    Float? // דריסה ידנית (גובר על הסכום מ-SUMIT)
  sumitAmount Float? // סכום אוטומטי מחשבוניות SUMIT (סכום החשבוניות לאותו סוג/חודש)
  status    PaymentStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)
  statusId  String?
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([clientId, year, month, kind])
  @@index([year])
}

// מילות מפתח לסיווג חשבוניות SUMIT לריטיינר/חד-פעמי — ניתנות לעריכה בדשבורד.
model PaymentKeyword {
  id        String   @id @default(cuid())
  keyword   String
  kind      String // "retainer" | "oneoff"
  createdAt DateTime @default(now())

  @@unique([keyword, kind])
}

// מעקב חשבוניות SUMIT שכבר הוחלו על לוח התשלומים — לאידמפוטנטיות:
// כל חשבונית מעובדת פעם אחת (getdetails יקר), והתא מחושב מחדש מסכום הרשומות.
// clientId ריק = חשבונית ללא לקוח תואם (לא מוחלת; נשמרת כדי לא לעבד שוב).
model SumitInvoice {
  documentID Int      @id // SUMIT DocumentID
  clientId   String
  year       Int
  month      Int // 1-12
  retainer   Float    @default(0)
  oneoff     Float    @default(0)
  appliedAt  DateTime @default(now())

  @@index([clientId, year, month])
}

// משוב עובדים על המערכת — כל עובד משרד יכול לשלוח מכל מקום; מרוכז למנהלים.
model Feedback {
  id         String   @id @default(cuid())
  authorId   String? // מזהה העובד (ללא FK — נשמר גם אם המשתמש נמחק)
  authorName String // תצלום שם השולח
  category   String   @default("improvement") // "improvement" | "bug" | "idea" | "other"
  text       String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([resolved, createdAt])
}

model Reminder {
  id        String    @id @default(cuid())
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  channel   String    @default("email") // "email" | "sms" | "whatsapp"
  target    String    @default("agent") // "agent" (סוכן/משרד) | "lead" (הלקוח הסופי)
  remindAt  DateTime
  status    String    @default("pending") // "pending" | "sent" | "failed" | "skipped"
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  @@index([status, remindAt])
}

// ---------------------------------------------------------------------------
// Documents — files on S3-compatible storage (R2), local-disk driver in dev
// ---------------------------------------------------------------------------

model Document {
  id           String    @id @default(cuid())
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String
  category     String // "agreement" | "invoice" | "receipt_*" | financial types from SUMIT | ...
  title        String
  month        String? // "2026-07" — receipts are grouped by month
  fileKey      String? // key in storage (null for external/SUMIT docs)
  fileName     String
  mimeType     String
  size         Int       @default(0)
  // מסמכים חיצוניים (SUMIT): קישור ישיר + מזהה למניעת כפילות.
  provider     String?   // null = הועלה אצלנו | "sumit"
  externalId   String?   // מזהה המסמך במערכת החיצונית
  externalUrl  String?   // קישור להורדה
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId    String?
  unitType     UnitType? @relation(fields: [unitTypeId], references: [id], onDelete: SetNull)
  unitTypeId   String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?
  createdAt    DateTime  @default(now())

  contracts Contract[]

  @@unique([provider, externalId])
  @@index([clientId, category])
  @@index([clientId, month])
}

// ---------------------------------------------------------------------------
// הצעות מחיר של המשרד — מעקב עד סגירה. הצעה פתוחה שלא טופלה כמה ימים
// מופיעה בפאנל "הצעות מחיר ממתינות" בסקירה הכללית.
// ---------------------------------------------------------------------------

model Quote {
  id        String   @id @default(cuid())
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId  String? // אופציונלי — הצעות יוצאות גם למתעניינים שאינם לקוחות עדיין
  recipient String // למי נשלחה — שם העסק / איש הקשר
  title     String // נושא ההצעה
  amount    Float?
  status    String   @default("sent") // "sent" | "followup" | "won" | "lost"
  sentAt    DateTime @default(now())
  notes     String?
  // פרטי קשר לפתיחת לקוח אוטומטית באישור ההצעה.
  company   String?
  phone     String?
  email     String?
  // קובץ ההצעה (PDF) — namespace נפרד של המשרד: agency/quotes/...
  fileKey   String?
  fileName  String?
  mimeType  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  engagement Engagement?

  @@index([status, updatedAt])
}

// "נכנס לעבודה" — לקוח שאישר הצעה. מרכז את ישיבת ההתנעה וצ'ק-ליסט
// האונבורדינג כדי ששום שלב בקליטת הלקוח לא ייפול.
model Engagement {
  id          String    @id @default(cuid())
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  quote       Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  quoteId     String?   @unique
  title       String // תקציר ההיקף (נושא ההצעה)
  kickoffAt   DateTime?
  kickoffDone Boolean   @default(false)
  status      String    @default("active") // "active" | "done"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks EngagementTask[]

  @@index([status, createdAt])
}

model EngagementTask {
  id           String     @id @default(cuid())
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String
  title        String
  assignee     User?      @relation("EngagementTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId   String?
  done         Boolean    @default(false)
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([engagementId])
}

// ---------------------------------------------------------------------------
// גאנט חודשי ללקוח — תוכנית שבוע-אחר-שבוע ל-6 חודשים. המשרד מתכנן ומסמן
// ביצוע; הלקוח צופה. נגיש בשני הצדדים.
// ---------------------------------------------------------------------------

model GanttPlan {
  id         String   @id @default(cuid())
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String   @unique
  startMonth String // "YYYY-MM" — עוגן 6 החודשים
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tasks GanttTask[]
}

model GanttTask {
  id        String   @id @default(cuid())
  plan      GanttPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId    String
  title     String
  ownerName String?
  color     String   @default("#22d3ee")
  order     Int      @default(0)
  // סטטוס לכל שבוע (0..23) כ-JSON: {"3":"planned","4":"done"}
  weeks     String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
}

// ---------------------------------------------------------------------------
// Budgets — monthly/weekly, per client / campaign / project. CPL computed.
// ---------------------------------------------------------------------------

model Budget {
  id          String    @id @default(cuid())
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId  String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String?
  period      String    @default("monthly") // "monthly" | "weekly"
  periodKey   String // monthly: "2026-07" | weekly: "2026-W28"
  amount      Float // planned budget
  spend       Float     @default(0) // actual spend (manual entry; auto later)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([clientId, campaignId, projectId, period, periodKey])
  @@index([clientId, periodKey])
}

// ---------------------------------------------------------------------------
// Real-estate module
// ---------------------------------------------------------------------------

model Project {
  id          String   @id @default(cuid())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  name        String
  logoKey     String? // project logo
  description String?
  status      String   @default("active") // "active" | "done" | "archived"
  // בקשת חומרים מהלקוח ("מכולת"): נשלחת בפתיחה, תזכורות עד קבלה.
  materialsRequestedAt    DateTime?
  materialsReceived       Boolean   @default(false)
  materialsReceivedAt     DateTime?
  materialsRemindersSent  Int       @default(0)
  materialsLastRemindedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unitTypes        UnitType[]
  campaigns        Campaign[]
  leads            Lead[]
  documents        Document[]
  budgets          Budget[]
  purchaseRequests PurchaseRequest[]
  contracts        Contract[]
  assignments      ProjectAssignment[]
  sources          LeadSource[]
  materials        ProjectMaterial[]
  designTasks      DesignTask[]

  @@unique([clientId, name])
  @@index([clientId])
  @@index([materialsReceived, materialsRequestedAt])
}

// פריט חומרים שנדרש מהלקוח בפרויקט (מופק מתבנית או ידני).
model ProjectMaterial {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  label     String
  received  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
}

// תבנית "מכולת" — רשימת חומרים לפי סוג פרויקט (נדל"ן / SEO / כללי / חופשי).
model MaterialTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  // רשימת פריטים כ-JSON array של מחרוזות.
  items     String   @default("[]")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A unit type in a project: "דירת גן 4 חד׳" with price + inventory.
model UnitType {
  id         String   @id @default(cuid())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  name       String
  rooms      Float?
  price      Float    @default(0)
  totalUnits Int      @default(0)
  soldUnits  Int      @default(0) // maintained by the inventory automation
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leads            Lead[]
  documents        Document[] // floor plans
  priceChanges     PriceChange[]
  inventoryEvents  InventoryEvent[]
  purchaseRequests PurchaseRequest[]
  contracts        Contract[]

  @@unique([projectId, name])
  @@index([projectId])
}

// Price history for a unit type.
model PriceChange {
  id         String   @id @default(cuid())
  unitType   UnitType @relation(fields: [unitTypeId], references: [id], onDelete: Cascade)
  unitTypeId String
  oldPrice   Float
  newPrice   Float
  changedBy  String? // user name (denormalized)
  createdAt  DateTime @default(now())

  @@index([unitTypeId])
}

// Audit trail of every inventory change — the automation writes here.
model InventoryEvent {
  id         String   @id @default(cuid())
  unitType   UnitType @relation(fields: [unitTypeId], references: [id], onDelete: Cascade)
  unitTypeId String
  delta      Int // -1 sold, +1 reverted/added
  reason     String // "sold" | "reverted" | "manual"
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId     String?
  actorName  String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([unitTypeId, createdAt])
}

model PurchaseRequest {
  id         String    @id @default(cuid())
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId     String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId  String?
  unitType   UnitType? @relation(fields: [unitTypeId], references: [id], onDelete: SetNull)
  unitTypeId String?
  status     String    @default("new") // "new" | "approved" | "rejected" | "converted"
  amount     Float?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([clientId, status])
}

model Contract {
  id         String    @id @default(cuid())
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId     String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId  String?
  unitType   UnitType? @relation(fields: [unitTypeId], references: [id], onDelete: SetNull)
  unitTypeId String?
  value      Float     @default(0)
  signedAt   DateTime?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentId String? // the signed PDF
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([clientId])
  @@index([projectId])
}

// "2 המודעות החזקות של החודש" — manual marking now, auto via Meta later.
model TopAd {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  month     String // "2026-07"
  rank      Int // 1 | 2
  name      String
  platform  String?
  imageKey  String? // creative screenshot in storage
  metric    String? // free text: "42 לידים, 38 ₪ לליד"
  notes     String?
  createdAt DateTime @default(now())

  @@unique([clientId, month, rank])
  @@index([clientId, month])
}

// ---------------------------------------------------------------------------
// Messaging — one layer, channel adapters (email now; SMS/WhatsApp when
// a provider is connected). Every outgoing message is logged here.
// ---------------------------------------------------------------------------

model Message {
  id          String     @id @default(cuid())
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String?
  channel     String // "email" | "sms" | "whatsapp"
  to          String
  subject     String?
  body        String
  kind        String     @default("system") // "reminder" | "automation" | "broadcast" | "system"
  status      String     @default("pending") // "pending" | "sent" | "failed" | "skipped"
  error       String?
  lead        Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId      String?
  broadcast   Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  broadcastId String?
  sentAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([clientId, createdAt])
  @@index([broadcastId])
  @@index([status])
}

// A broadcast (הודעת תפוצה) to a filtered set of leads. Consent enforced.
model Broadcast {
  id          String   @id @default(cuid())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  name        String
  channel     String // "email" | "sms" | "whatsapp"
  subject     String?
  body        String
  filterJson  String? // the lead filter used
  total       Int      @default(0)
  sent        Int      @default(0)
  failed      Int      @default(0)
  status      String   @default("draft") // "draft" | "running" | "done"
  createdBy   String? // user name
  createdAt   DateTime @default(now())

  messages Message[]

  @@index([clientId])
}

// Automation rule: on trigger, send a templated message.
model Automation {
  id               String      @id @default(cuid())
  client           Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId         String
  name             String
  trigger          String // "lead_created" | "status_changed"
  status           LeadStatus? @relation(fields: [statusId], references: [id], onDelete: Cascade)
  statusId         String? // for "status_changed": which status fires it
  channel          String      @default("email") // "email" | "sms" | "whatsapp"
  recipientType    String      @default("client_users") // "client_users" | "agents" | "custom"
  customRecipients String? // JSON array of emails/phones
  template         String // body with {{placeholders}}
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([clientId, trigger])
}

// נוסח הודעה שמור לשימוש חוזר בתפוצה ובאוטומציות.
model MessageTemplate {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  name      String
  channel   String   @default("email") // "email" | "sms" | "whatsapp"
  subject   String?
  body      String
  createdAt DateTime @default(now())

  @@unique([clientId, name])
  @@index([clientId])
}

// יומן פעולות רגישות במערכת (משתמשים, לקוחות, הרשאות, חיבורים).
model AuditLog {
  id         String   @id @default(cuid())
  actorName  String
  actorId    String?
  action     String // "user_created" | "user_updated" | "user_deactivated" | "client_created" | "client_updated" | "client_deactivated" | "integration_connected" | ...
  targetType String // "user" | "client" | "integration" | "status" | ...
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// External integrations (per client or global)
// ---------------------------------------------------------------------------

model Integration {
  id           String    @id @default(cuid())
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String? // null = agency-global (e.g. SMS provider)
  kind         String // "paycall" | "meta" | "search_console" | "ga4" | "sms" | "whatsapp"
  status       String    @default("disconnected") // "disconnected" | "connected" | "error"
  config       String? // JSON config (ids, property ids...)
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([clientId, kind])
  @@index([kind])
}

// Aggregated ad-platform insights per month (Meta): WhatsApp conversation
// starts, spend, leads — filled by the Meta sync when connected (Phase 3).
model AdInsight {
  id            String   @id @default(cuid())
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  month         String // "2026-07"
  source        String   @default("meta")
  campaignName  String
  whatsappCount Int      @default(0)
  leadsCount    Int      @default(0)
  spend         Float    @default(0)
  impressions   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([clientId, month, source, campaignName])
  @@index([clientId, month])
}

// ---------------------------------------------------------------------------
// SEO module — synced snapshots so dashboards load instantly
// ---------------------------------------------------------------------------

model SeoSnapshot {
  id          String   @id @default(cuid())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  date        String // "2026-07-13"
  source      String // "search_console" | "ga4"
  clicks      Int?
  impressions Int?
  position    Float? // avg position that day
  sessions    Int?
  users       Int?
  conversions Int?
  data        String? // JSON extras
  createdAt   DateTime @default(now())

  @@unique([clientId, date, source])
  @@index([clientId, date])
}

model SeoKeyword {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  keyword   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  ranks SeoKeywordRank[]

  @@unique([clientId, keyword])
}

model SeoKeywordRank {
  id          String     @id @default(cuid())
  keyword     SeoKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  keywordId   String
  date        String // "2026-07-13"
  position    Float
  clicks      Int?
  impressions Int?

  @@unique([keywordId, date])
}

// ---------------------------------------------------------------------------
// Legacy — audit log of the old Lead Manager scraper (kept until sunset)
// ---------------------------------------------------------------------------

model SyncLog {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String    @default("running") // success | error | running
  leadsFound     Int       @default(0)
  leadsCreated   Int       @default(0)
  leadsUpdated   Int       @default(0)
  alertTriggered Boolean   @default(false)
  message        String?

  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// מודול סטודיו ועיצוב (צד משרד) — מחזור מבריף ועד אישור סופי.
// סטטוסים: scheduled → in_progress → sent_to_client → client_feedback →
//          final_review → qc → approved. דגל overdue + מונה round לתיקונים.
// ---------------------------------------------------------------------------

model DesignTask {
  id          String   @id @default(cuid())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  title       String
  briefType   String   @default("post") // landing|logo|post|banner|print|branding
  brief       String? // הבריף המפורט למעצב
  specs       String? // מידות/פורמט/דגשים טכניים
  priority    String   @default("normal") // low|normal|high
  designer    User?    @relation("DesignTaskDesigner", fields: [designerId], references: [id], onDelete: SetNull)
  designerId  String?
  scheduledAt DateTime? // הסלוט בלו"ז של המעצב/ת
  dueAt       DateTime? // דדליין ללקוח
  status      String   @default("scheduled")
  round       Int      @default(1) // סבב תיקונים נוכחי
  overdue     Boolean  @default(false)
  qcBy        User?    @relation("DesignTaskQc", fields: [qcById], references: [id], onDelete: SetNull)
  qcById      String?
  qcAt        DateTime?
  approvedAt  DateTime?
  createdBy   User?    @relation("DesignTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  clientNotifiedAt DateTime? // מתי נשלח ללקוח לאישור (לחישוב תזכורות)
  remindersSent    Int    @default(0)
  calendarTaskId   String? // ה-Task המקושר ביומן של המעצב/ת (נוצר בתזמון)
  approvalToken    String? @unique // טוקן קישור-אישור ללקוח ללא התחברות
  group      DesignGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId    String? // קבוצה בלוח הסטודיו (כמו Monday)
  orderIndex Int     @default(0) // סדר בתוך הקבוצה (לגרירה)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets   DesignAsset[]
  feedback DesignFeedback[]
  messages DesignMessage[]

  @@index([status])
  @@index([designerId, scheduledAt])
  @@index([clientId])
  @@index([groupId, orderIndex])
}

// קבוצה בלוח הסטודיו (כמו Monday) — לסידור המשימות.
model DesignGroup {
  id         String   @id @default(cuid())
  name       String
  color      String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  tasks DesignTask[]
}

model DesignAsset {
  id           String     @id @default(cuid())
  designTask   DesignTask @relation(fields: [designTaskId], references: [id], onDelete: Cascade)
  designTaskId String
  kind         String     @default("deliverable") // reference (משרד→מעצב) | deliverable (מעצב→לקוח) | feedback (לקוח→מעצב)
  feedbackId   String? // אם kind=feedback — ה-DesignFeedback שאליו הקובץ מצורף
  round        Int        @default(1)
  fileKey      String?
  fileName     String?
  mimeType     String?
  note         String?
  uploadedBy   User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?
  createdAt    DateTime   @default(now())

  @@index([designTaskId])
}

model DesignFeedback {
  id           String     @id @default(cuid())
  designTask   DesignTask @relation(fields: [designTaskId], references: [id], onDelete: Cascade)
  designTaskId String
  round        Int        @default(1)
  decision     String // "approved" | "changes"
  text         String?
  authorName   String?
  createdAt    DateTime   @default(now())

  @@index([designTaskId])
}

// שיחת וואטסאפ דו-כיוונית מול לקוח (פר-לקוח) — חלון ההתכתבות בתוך המערכת.
model WhatsappMessage {
  id          String   @id @default(cuid())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  // שיחה מול ליד (צ'אט מכרטיס הליד). null = שיחת המשרד מול הלקוח עצמו.
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String?
  direction   String // "in" (לקוח→משרד) | "out" (משרד→לקוח)
  body        String
  fromPhone   String? // מספר השולח (בהודעה נכנסת)
  authorName  String? // שם השולח מהמשרד (בהודעה יוצאת)
  waMessageId String? @unique // idMessage מ-Green API (למניעת כפילויות)
  mediaKey    String? // מפתח R2 של קובץ יוצא (לצפייה במערכת)
  mediaUrl    String? // קישור חיצוני לקובץ נכנס (downloadUrl מ-Green API)
  mediaName   String? // שם הקובץ
  mediaMime   String? // סוג הקובץ
  createdAt   DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([leadId, createdAt])
}

// שרשור התכתבות משרד↔לקוח על משימת עיצוב (צ'אט בפורטל).
model DesignMessage {
  id           String     @id @default(cuid())
  designTask   DesignTask @relation(fields: [designTaskId], references: [id], onDelete: Cascade)
  designTaskId String
  channel      String  @default("client") // "client" (מעצב↔לקוח) | "internal" (משרד בלבד: מעצב↔מנהל תיק)
  assetId      String? // אם מוגדר — הערה ממוקדת על תוצר ספציפי; אחרת צ'אט כללי
  authorSide   String // "agency" | "client"
  authorId     String?
  authorName   String?
  body         String
  createdAt    DateTime   @default(now())
  editedAt       DateTime? // אם מוגדר — העדכון נערך אחרי הפרסום (מציג "נערך")
  sharedChannels String? // ערוצים שאליהם נשלח הבלוק ללקוח (רשימה מופרדת בפסיקים: "email,whatsapp")
  sharedAt       DateTime? // מתי נשלח לאחרונה ללקוח

  @@index([designTaskId])
}
